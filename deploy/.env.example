# Settings of deploy/docker-compose.yml. Copy to deploy/.env and fill in.
BACKEND_API_URL=http://host.docker.internal:8080/api/v1
PUBLIC_SITE_URL=http://localhost:8080
DEPLOYMENT_REGION=ir
POSTGRES_PASSWORD=
PAYLOAD_SECRET=
REVALIDATE_SECRET=
# The CMS for news drafts (docs/news.md): http://cms:3001/api and the newsbot account's API key.
# Both empty: the worker only collects.
NEWS_CMS_API_URL=
NEWS_CMS_API_KEY=

# PostgreSQL of the CMS: its own database and role, not the exchange's.
DATABASE_URL=postgres://cms:cms@localhost:5432/cms
# At least 32 random characters; signs sessions. Same on every node.
PAYLOAD_SECRET=
# Where the admin panel is served: an internal domain, never a public blog domain.
CMS_PUBLIC_URL=http://localhost:3001
# Web deployments to revalidate on publish, comma-separated: https://blog.example.com/api/revalidate
WEB_REVALIDATE_URLS=
# Shared with the web app; at least 32 characters.
REVALIDATE_SECRET=
# Media storage, required in production (shared by every node). Any S3-compatible store.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# PostgreSQL of the CMS: its own database and role, not the exchange's.
DATABASE_URL=postgres://cms:cms@localhost:5432/cms
# At least 32 random characters; signs sessions. Same on every node.
PAYLOAD_SECRET=
# Where the admin panel is served: an internal domain, never a public blog domain.
CMS_PUBLIC_URL=http://localhost:3001
# Web deployments to revalidate on publish, comma-separated: https://blog.example.com/api/revalidate
WEB_REVALIDATE_URLS=
# Shared with the web app; at least 32 characters.
REVALIDATE_SECRET=
# The web deployment editors preview drafts on (signed links, REVALIDATE_SECRET): https://blog.example.com
WEB_PREVIEW_URL=
# Media storage, required in production (shared by every node). Any S3-compatible store.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Staff sign in through an identity-aware proxy with a second factor (docs/cms.md#staff-sign-in).
# The secret it sends in X-CMS-Proxy-Secret, 32+ characters; required in production.
CMS_AUTH_PROXY_SECRET=
# The header in which it sends the signed-in email.
CMS_AUTH_PROXY_EMAIL_HEADER=x-auth-request-email
# true or false; on in production by default. false accepts passwords alone (logged at every start).
CMS_AUTH_PROXY_REQUIRED=

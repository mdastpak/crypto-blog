    "@payloadcms/ui": "3.93.0",
    "graphql": "16.15.0",
    "next": "16.4.5",
    "payload": "3.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tsx": "4.23.15",

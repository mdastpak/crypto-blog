# The news store: its own PostgreSQL database (or the CMS's server, another database).
DATABASE_URL=postgres://news:news@localhost:5432/news
# ir collects Iranian and global sources; international only global ones.
DEPLOYMENT_REGION=ir
# The sources (docs/news.md); copy sources.example.json.
NEWS_SOURCES_FILE=sources.json
# A page about the bot, named in its User-Agent so source owners can reach us.
NEWS_BOT_INFO_URL=https://blog.example.com/about/news-bot
# The market data catalog, to tag the coins an item mentions. Optional.
BACKEND_API_URL=http://localhost:8080/api/v1
# This node's egress: unset is direct, or an http(s) proxy (per node).
NEWS_HTTP_PROXY=
CONCURRENCY=4
POLL_SECONDS=10
LEASE_SECONDS=120
HOST_MIN_INTERVAL_MS=2000
FETCH_TIMEOUT_MS=15000
CLUSTER_WINDOW_HOURS=48
PORT=3002
LOG_LEVEL=info

{
  "name": "news-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.0",
    "pg": "8.20.0",
    "tsx": "4.23.15",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.20.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}

{
  "paths": {
    "/api/v1/market-data/assets": {
      "get": {
        "parameters": [
          {
            "maxLength": 64,
            "type": "string",
            "description": "The exact symbol, or a part of the name or slug, in any case",
            "name": "q",
            "in": "query"
          },
          {
            "maximum": 200,
            "minimum": 1,
            "type": "integer",
            "description": "The number of assets, 50 by default",
            "name": "limit",
            "in": "query"
          },
          {
            "type": "string",
            "description": "The next_cursor of the previous page",
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/models.APIResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "info": {
                      "$ref": "#/definitions/marketdata.AssetPage"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "/api/v1/market-data/assets/{slug}": {
      "get": {
        "parameters": [
          {
            "type": "string",
            "description": "The slug of the asset, such as bitcoin",
            "name": "slug",
            "in": "path",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/models.APIResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "info": {
                      "$ref": "#/definitions/marketdata.AssetView"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "/api/v1/market-data/assets/{slug}/venues": {
      "get": {
        "parameters": [
          {
            "type": "string",
            "description": "The slug of the asset, such as bitcoin",
            "name": "slug",
            "in": "path",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/models.APIResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "info": {
                      "$ref": "#/definitions/marketdata.VenueComparison"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "/api/v1/market-data/assets/{slug}/candles": {
      "get": {
        "parameters": [
          {
            "type": "string",
            "description": "The slug of the asset, such as bitcoin",
            "name": "slug",
            "in": "path",
            "required": true
          },
          {
            "type": "string",
            "description": "The venue, such as binance or nobitex",
            "name": "venue",
            "in": "query",
            "required": true
          },
          {
            "type": "string",
            "description": "The quote symbol, such as USDT or IRT",
            "name": "quote",
            "in": "query",
            "required": true
          },
          {
            "enum": [
              "1m",
              "5m",
              "15m",
              "1h",
              "1d"
            ],
            "type": "string",
            "description": "The candle interval. The pairs of each collection tier are kept at some of them only: 1m for the hot pairs, 5m and 15m for the hot and active pairs.",
            "name": "interval",
            "in": "query",
            "required": true
          },
          {
            "type": "string",
            "format": "date-time",
            "description": "The first open time, RFC 3339",
            "name": "from",
            "in": "query"
          },
          {
            "type": "string",
            "format": "date-time",
            "description": "The end, exclusive, RFC 3339",
            "name": "to",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/models.APIResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "info": {
                      "$ref": "#/definitions/marketdata.Chart"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "/api/v1/market-data/feed/assets": {
      "get": {
        "parameters": [
          {
            "type": "string",
            "format": "date-time",
            "description": "The first change to list, RFC 3339; ignored with a cursor",
            "name": "updated_since",
            "in": "query"
          },
          {
            "maximum": 200,
            "minimum": 1,
            "type": "integer",
            "description": "The number of assets, 50 by default",
            "name": "limit",
            "in": "query"
          },
          {
            "type": "string",
            "description": "The next_cursor of the previous page",
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/models.APIResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "info": {
                      "$ref": "#/definitions/marketdata.FeedPage"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "/api/v1/public/currencies": {
      "get": {
        "parameters": [
          {
            "maxLength": 64,
            "type": "string",
            "description": "Text in the symbol, English name, or Persian name, normalized; symbols that match it come first",
            "name": "q",
            "in": "query"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "csv",
            "description": "Symbols, in any case, repeated or comma-separated",
            "name": "symbol",
            "in": "query"
          },
          {
            "maxLength": 64,
            "type": "string",
            "description": "Text in the English name, in any case",
            "name": "en_name",
            "in": "query"
          },
          {
            "maxLength": 64,
            "type": "string",
            "description": "Text in the Persian name, with Arabic letters and Persian or Arabic digits matching the Persian ones",
            "name": "fa_name",
            "in": "query"
          },
          {
            "maxLength": 128,
            "type": "string",
            "description": "The contract address, in any case",
            "name": "contract",
            "in": "query"
          },
          {
            "type": "boolean",
            "description": "Only currencies with a contract, or only those without",
            "name": "has_contract",
            "in": "query"
          },
          {
            "type": "boolean",
            "description": "Only tokens, or only currencies that are not",
            "name": "is_token",
            "in": "query"
          },
          {
            "type": "boolean",
            "description": "Only fiat currencies, or only those that are not",
            "name": "if_fiat",
            "in": "query"
          },
          {
            "type": "string",
            "format": "date-time",
            "description": "Created at or after this RFC 3339 time",
            "name": "created_since",
            "in": "query"
          },
          {
            "type": "string",
            "format": "date-time",
            "description": "Created before this RFC 3339 time",
            "name": "created_until",
            "in": "query"
          },
          {
            "type": "string",
            "format": "date-time",
            "description": "Updated at or after this RFC 3339 time",
            "name": "updated_since",
            "in": "query"
          },
          {
            "type": "boolean",
            "description": "true: only the favorites of the signed-in user, which needs their access token",
            "name": "favorites",
            "in": "query"
          },
          {
            "enum": [
              "symbol",
              "-symbol",
              "en_name",
              "-en_name",
              "created_at",
              "-created_at",
              "updated_at",
              "-updated_at"
            ],
            "type": "string",
            "description": "The order, with - for descending; the hk breaks ties",
            "name": "sort",
            "in": "query"
          },
          {
            "maximum": 200,
            "minimum": 1,
            "type": "integer",
            "description": "The number of currencies, 50 by default",
            "name": "limit",
            "in": "query"
          },
          {
            "type": "string",
            "description": "The next_cursor of the previous page",
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/models.APIResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "info": {
                      "$ref": "#/definitions/public.CurrencyPage"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "/api/v1/public/locales": {
      "get": {
        "parameters": [
          {
            "type": "string",
            "description": "A locale for this request, such as fa",
            "name": "lang",
            "in": "query"
          },
          {
            "type": "string",
            "description": "The locale an app chose",
            "name": "X-Locale",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/models.APIResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "info": {
                      "$ref": "#/definitions/public.LocalesInfo"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "/api/v1/public/site": {
      "get": {
        "parameters": [
          {
            "type": "string",
            "default": "/",
            "description": "The page, a local path such as /markets?tab=spot",
            "name": "path",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/models.APIResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "info": {
                      "$ref": "#/definitions/public.SiteInfo"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "/api/v1/public/status": {
      "get": {
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/models.APIResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "info": {
                      "$ref": "#/definitions/platform.Status"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "definitions": {
    "i18n.Locale": {
      "type": "object",
      "properties": {
        "code": {
          "description": "Code is the canonical BCP 47 tag, such as \"fa\" or \"en-GB\".",
          "type": "string",
          "example": "fa"
        },
        "dir": {
          "description": "Dir is the direction of its text: \"ltr\" or \"rtl\".",
          "type": "string",
          "enum": [
            "ltr",
            "rtl"
          ],
          "example": "rtl"
        },
        "name": {
          "description": "Name is the name of the language in English.",
          "type": "string",
          "example": "Persian"
        },
        "native_name": {
          "description": "NativeName is the name of the language in itself, for a language\nswitcher.",
          "type": "string",
          "example": "فارسی"
        }
      }
    },
    "marketdata.AssetPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/marketdata.AssetView"
          }
        },
        "next_cursor": {
          "description": "NextCursor asks for the next page. It is left out on the last page.",
          "type": "string"
        }
      }
    },
    "marketdata.AssetView": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "attribution": {
          "type": "string"
        },
        "circulating_supply": {
          "type": "string"
        },
        "contracts": {
          "description": "Contracts are the contracts of a token, by network.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/marketdata.Contract"
          }
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "description": "Kind is coin, token, or unknown.",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "links": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "logo_url": {
          "type": "string"
        },
        "market_cap_rank": {
          "type": "integer"
        },
        "max_supply": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "total_supply": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "verified": {
          "description": "Verified is true only for an asset that an administrator linked to a\ncurrency listed on this exchange; Label says the same for display.",
          "type": "boolean"
        }
      }
    },
    "marketdata.Attribution": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "marketdata.CandlePoint": {
      "type": "object",
      "properties": {
        "c": {
          "type": "string"
        },
        "h": {
          "type": "string"
        },
        "l": {
          "type": "string"
        },
        "o": {
          "type": "string"
        },
        "t": {
          "description": "T is the open time of the candle.",
          "type": "string"
        },
        "v": {
          "description": "V is the volume in the base asset.",
          "type": "string"
        }
      }
    },
    "marketdata.Chart": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string"
        },
        "candles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/marketdata.CandlePoint"
          }
        },
        "from": {
          "type": "string"
        },
        "interval": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "marketdata.Contract": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "network": {
          "type": "string"
        }
      }
    },
    "marketdata.FeedItem": {
      "type": "object",
      "properties": {
        "asset": {
          "description": "Asset is the asset with its description, links, and contracts, as\nGET /market-data/assets/{slug} serves it.",
          "allOf": [
            {
              "$ref": "#/definitions/marketdata.AssetView"
            }
          ]
        },
        "attribution": {
          "description": "Attribution must be shown with the data of the asset.",
          "allOf": [
            {
              "$ref": "#/definitions/marketdata.Attribution"
            }
          ]
        },
        "removed": {
          "type": "boolean"
        },
        "slug": {
          "type": "string"
        },
        "structured_data": {
          "description": "StructuredData is a schema.org description of the asset, for the\nJSON-LD of a page. The page adds its own url.",
          "type": "object"
        },
        "updated_at": {
          "type": "string"
        }
      }
    },
    "marketdata.FeedPage": {
      "type": "object",
      "properties": {
        "has_more": {
          "description": "HasMore says that more assets changed already: ask again at once.",
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/marketdata.FeedItem"
          }
        },
        "next_cursor": {
          "description": "NextCursor resumes the feed after the last item. It is set on every\npage, the last one too: keep it, and ask with it later for the\nassets that change after.",
          "type": "string"
        }
      }
    },
    "marketdata.VenueComparison": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "outlier_percent": {
          "type": "string"
        },
        "quotes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/marketdata.VenueQuote"
          }
        },
        "stale_after_seconds": {
          "type": "integer"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "marketdata.VenueQuote": {
      "type": "object",
      "properties": {
        "ask": {
          "type": "string"
        },
        "bid": {
          "type": "string"
        },
        "high": {
          "type": "string"
        },
        "last": {
          "type": "string"
        },
        "low": {
          "type": "string"
        },
        "median": {
          "description": "Median is the median of the fresh prices of the same quote, when\nenough venues have one.",
          "type": "string"
        },
        "observed_at": {
          "type": "string"
        },
        "open": {
          "type": "string"
        },
        "outlier": {
          "description": "Outlier: the price is too far from the median of the venues.",
          "type": "boolean"
        },
        "pair": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "stale": {
          "description": "Stale: the ticker is older than the staleness limit.",
          "type": "boolean"
        },
        "venue": {
          "type": "string"
        },
        "venue_name": {
          "type": "string"
        },
        "volume_base": {
          "type": "string"
        },
        "volume_quote": {
          "type": "string"
        }
      }
    },
    "models.APIResponse": {
      "type": "object",
      "properties": {
        "code": {
          "description": "Code names the error of a response of status 400 or more, for\nclients to act on; Message is for people and may change.",
          "type": "string"
        },
        "info": {
          "description": "Info can hold any type of data (e.g., list or object)"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "description": "RequestID is the X-Request-ID of an error response, to quote when\nreporting it.",
          "type": "string"
        },
        "status": {
          "type": "integer"
        }
      }
    },
    "models.Currency": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "deleted_at": {
          "type": "string"
        },
        "hk": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "info": {
          "$ref": "#/definitions/models.CurrencyInfo"
        },
        "lifecycle": {
          "description": "Lifecycle is where the currency is in a delisting, and what users may\ndo with it now (#216).",
          "allOf": [
            {
              "$ref": "#/definitions/models.CurrencyLifecycle"
            }
          ]
        },
        "migration": {
          "description": "Migration is the migration that moves the holders of this currency to\nanother one, from its announcement on (#215).",
          "allOf": [
            {
              "$ref": "#/definitions/models.CurrencyMigration"
            }
          ]
        },
        "previous_symbols": {
          "description": "PreviousSymbols are the symbols the currency had before a rebrand,\nnewest first (#215). They stay reserved for it, and the lists find the\ncurrency by them.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "MATIC"
          ]
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "version": {
          "description": "Version counts the changes of the currency. Only administrators see\nit; it is 0, and left out, in public responses.",
          "type": "integer"
        }
      }
    },
    "models.CurrencyCapabilities": {
      "type": "object",
      "properties": {
        "buy": {
          "type": "boolean"
        },
        "convert_from": {
          "type": "boolean"
        },
        "convert_into": {
          "type": "boolean"
        },
        "deposit": {
          "type": "boolean"
        },
        "listed": {
          "description": "Listed is false when the currency is left out of the public lists. It\ncan still be read by its hk, for history.",
          "type": "boolean"
        },
        "sell": {
          "type": "boolean"
        },
        "withdraw": {
          "type": "boolean"
        }
      }
    },
    "models.CurrencyInfo": {
      "type": "object",
      "properties": {
        "contract": {
          "type": "string"
        },
        "en_name": {
          "type": "string"
        },
        "fa_name": {
          "type": "string"
        },
        "if_fiat": {
          "type": "boolean"
        },
        "is_token": {
          "type": "boolean"
        },
        "logo_url": {
          "description": "LogoURL is the https URL of the currency's logo (#215), or empty.",
          "type": "string",
          "example": "https://example.com/logos/usdt.svg"
        },
        "symbol": {
          "type": "string"
        }
      }
    },
    "models.CurrencyLifecycle": {
      "type": "object",
      "properties": {
        "capabilities": {
          "description": "Capabilities says what users may do with the currency now: the\ncapabilities of the state, with the overrides of administrators.",
          "allOf": [
            {
              "$ref": "#/definitions/models.CurrencyCapabilities"
            }
          ]
        },
        "next": {
          "description": "Next is the next scheduled step, when a delisting is under way.",
          "allOf": [
            {
              "$ref": "#/definitions/models.CurrencyLifecycleStep"
            }
          ]
        },
        "state": {
          "description": "State is active, or the step of a delisting that the currency is at.",
          "type": "string",
          "enum": [
            "active",
            "delist_announced",
            "deposits_disabled",
            "sell_only",
            "trading_halted",
            "withdrawal_only",
            "frozen",
            "delisted"
          ],
          "example": "active"
        }
      }
    },
    "models.CurrencyLifecycleStep": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "example": "deposits_disabled"
        }
      }
    },
    "models.CurrencyMigration": {
      "type": "object",
      "properties": {
        "forced": {
          "description": "Forced is true when holdings are converted, and false when the\nconversion is offered and the currency stays.",
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "next": {
          "description": "Next is the next scheduled phase.",
          "allOf": [
            {
              "$ref": "#/definitions/models.CurrencyMigrationPhase"

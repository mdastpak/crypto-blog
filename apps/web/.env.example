# Base URL of the exchange backend API, without a trailing slash.
BACKEND_API_URL=http://localhost:8080/api/v1
# Public URL of this blog (used for canonical URLs).
PUBLIC_SITE_URL=http://localhost:3000
# Release region, the same value as the backend's DEPLOYMENT_REGION: ir or international.
DEPLOYMENT_REGION=ir
# The exchange web app, for "Trade" links on listed coins. Optional.
EXCHANGE_APP_URL=
# Timeout of one request to the backend, in milliseconds.
BACKEND_TIMEOUT_MS=5000
# Seconds a node keeps serving after SIGTERM while readiness reports draining.
SHUTDOWN_DRAIN_SECONDS=10
# Locales served, in the order of the switcher. Default: fa,en (ir) or en,fa (international).
LOCALES=
# Locale of a visitor whose languages match none. Default: the region's language.
DEFAULT_LOCALE=
# Redirect a visitor to their country site on the first page of a visit (docs/sites.md).
SITE_DETECTION=true
SITE_TIMEOUT_MS=800
# Trust X-Forwarded-* headers. Only behind a load balancer that sets them.
TRUST_PROXY_HEADERS=false
# Brand of this release (apps/web/src/design/brands.ts).
BRAND=default
# Serve the component gallery at /{locale}/design. Keep it off in production.
DESIGN_GALLERY=false
LOG_LEVEL=info

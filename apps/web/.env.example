# Base URL of the exchange backend API, without a trailing slash.
BACKEND_API_URL=http://localhost:8080/api/v1
# Public URL of this blog (used for canonical URLs).
PUBLIC_SITE_URL=http://localhost:3000
# Release region, the same value as the backend's DEPLOYMENT_REGION: ir or international.
DEPLOYMENT_REGION=ir
# The exchange web app, for "Trade" links on listed coins. Optional.
EXCHANGE_APP_URL=
# The quotes the exchange lists every currency against (markets pages); IRT is dropped abroad.
MARKET_QUOTES=USDT,IRT
# Timeout of one request to the backend, in milliseconds.
BACKEND_TIMEOUT_MS=5000
# Seconds a node keeps serving after SIGTERM while readiness reports draining.
SHUTDOWN_DRAIN_SECONDS=10
# Locales served, in the order of the switcher. Default: fa,en (ir) or en,fa (international).
LOCALES=
# Locale of a visitor whose languages match none. Default: the region's language.
DEFAULT_LOCALE=
# Redirect a visitor to their country site on the first page of a visit (docs/sites.md).
SITE_DETECTION=true
SITE_TIMEOUT_MS=800
# Trust X-Forwarded-* headers. Only behind a load balancer that sets them.
TRUST_PROXY_HEADERS=false
# Brand of this release (apps/web/src/design/brands.ts).
BRAND=default
# Serve the component gallery at /{locale}/design. Keep it off in production.
DESIGN_GALLERY=false
LOG_LEVEL=info
# The CMS's REST API (docs/cms.md). Unset: no blog or campaign pages.
CMS_API_URL=http://localhost:3001/api
# Public base URL of CMS media, e.g. a CDN in front of the media bucket. Unset: proxied by this app.
CMS_MEDIA_URL=
# The hosts coin logos are fetched from by /coin-logo, comma-separated (docs/pages.md#coin-logos).
# COIN_LOGO_HOSTS=assets.coingecko.com,coin-images.coingecko.com,s2.coinmarketcap.com
# Shared with the CMS (its REVALIDATE_SECRET): signs revalidation calls and preview links. 32+ characters.
REVALIDATE_SECRET=
# API key of a CMS account with the viewer role, to show drafts in preview.
CMS_PREVIEW_API_KEY=
# The country site this deployment serves (ir, global, ...); hides content limited to other sites.
SITE_ID=

# Shared cache of every node (docs/deployment.md). Unset: each process caches for itself (one node only).
# One server:
CACHE_REDIS_URL=
# Or a Sentinel group (host:port,...) and its master name:
CACHE_REDIS_SENTINELS=
CACHE_REDIS_MASTER=
# Or a Redis Cluster (host:port,...):
CACHE_REDIS_CLUSTER=
# Credentials and TLS for Sentinel and Cluster (a URL carries its own).
CACHE_REDIS_USERNAME=
CACHE_REDIS_PASSWORD=
CACHE_REDIS_TLS=false
# Prefix of every cache key; give each deployment sharing a Redis its own.
CACHE_KEY_PREFIX=crypto-blog
# Allowed clock difference between nodes, in milliseconds.
CACHE_CLOCK_SKEW_MS=1000
# Strict-Transport-Security on every response. Set false only where some host is not HTTPS. Read at build time.
HSTS=true
# OpenTelemetry traces over OTLP; unset: no tracing. Other standard OTEL_* settings apply.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=crypto-blog-web
